---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { guides } from '../../data/guides.js';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const base = import.meta.env.BASE_URL;
const related = guides.filter((item) => item.slug !== guide.slug).slice(0, 2);
---
<SiteLayout title={`${guide.title} | RewardPath Guide`} description={guide.excerpt} active="guides">
  <article class="article-page">
    <header class="article-header"><div class="container article-header-inner"><div class="breadcrumb"><a href={base}>Home</a><span>/</span><a href={`${base}guides/`}>Guides</a><span>/</span><span>{guide.category}</span></div><span class="category-tag">{guide.category}</span><h1>{guide.title}</h1><p class="article-deck">{guide.excerpt}</p><div class="article-byline"><span>REWARDPATH EDITORIAL</span><span>·</span><span>{guide.date}</span><span>·</span><span>{guide.readTime}</span></div></div></header>
    <div class="container article-layout"><aside class="article-aside"><div class="aside-card"><span class="aside-icon">✳</span><strong>Before you participate</strong><p>Check the sponsor, read the official rules, and understand what information is collected.</p><a href={`${base}guides/spot-fake-gift-card-giveaways/`}>Safety checklist →</a></div></aside><div class="article-content"><p class="article-intro">{guide.intro}</p>{guide.sections.map((section) => <section class="article-section"><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}<div class="article-disclaimer"><strong>Editorial note</strong><p>This article is general educational information, not legal, tax, or financial advice. Promotion terms vary. Always read the official rules and verify details with the named sponsor.</p></div><a class="back-link" href={`${base}guides/`}>← Back to all guides</a></div></div>
  </article>
  <section class="related-section"><div class="container"><div class="section-heading"><div><span class="section-kicker">KEEP READING</span><h2>More helpful <em>guides.</em></h2></div><a class="text-link" href={`${base}guides/`}>All guides <span>→</span></a></div><div class="guide-grid">{related.map((item) => <a class="guide-card" href={`${base}guides/${item.slug}/`}><div class="guide-card-top"><span class="category-tag">{item.category}</span><span class="card-arrow">↗</span></div><h3>{item.title}</h3><p>{item.excerpt}</p><div class="guide-card-meta"><span>{item.readTime}</span><span>Read guide <b>→</b></span></div></a>)}</div></div></section>
</SiteLayout>
