---
import SiteLayout from '../layouts/SiteLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { guides } from '../data/guides.js';
const base = import.meta.env.BASE_URL;
const featured = guides.slice(0, 3);
---
<SiteLayout active="home">
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> THE SMARTER REWARDS REFERENCE</div>
        <h1>Know the offer.<br /><em>Protect your</em> information.</h1>
        <p class="hero-description">Straightforward guides to gift card promotions, rewards programs, and sweepstakes—so you can understand the terms before you take part.</p>
        <div class="hero-actions"><a class="button button-primary" href={`${base}guides/`}>Explore the guides <span>↗</span></a><a class="text-link" href={`${base}about/`}>How we work <span>→</span></a></div>
        <div class="hero-trust"><span class="trust-check">✓</span> Independent educational content <span class="trust-separator">·</span> No guaranteed-win promises</div>
      </div>
      <div class="hero-visual" aria-label="Illustration of a gift card and a checklist">
        <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
        <div class="visual-spark spark-one">✳</div><div class="visual-spark spark-two">✦</div>
        <div class="gift-card-illustration">
          <div class="gift-card-top"><span class="gift-chip"></span><span class="gift-card-label">REWARD CARD</span></div>
          <div class="gift-card-main"><span class="gift-card-symbol">$</span><div><strong>Read the<br />fine print.</strong><small>Clarity is valuable.</small></div></div>
          <div class="gift-card-bottom"><span>REWARDPATH GUIDE</span><span>•••• 2048</span></div>
        </div>
        <div class="floating-note note-left"><span class="note-icon">✓</span><span><strong>Check the rules</strong><small>Before you enter</small></span></div>
        <div class="floating-note note-right"><span class="note-icon note-icon-dark">i</span><span><strong>Know the sponsor</strong><small>Read the details</small></span></div>
        <div class="visual-caption">SMARTER ONLINE REWARDS START HERE</div>
      </div>
    </div>
    <div class="container hero-bottom"><span>BUILT FOR CLARITY</span><div class="hero-bottom-line"></div><span>GIFT CARDS · REWARDS · SWEEPSTAKES · ONLINE SAFETY</span></div>
  </section>

  <section class="principles-section section-space">
    <div class="container principles-grid">
      <div><span class="section-kicker">A BETTER WAY TO BROWSE</span><h2>Understand first.<br /><em>Decide second.</em></h2></div>
      <div class="principle-item"><span class="principle-number">01</span><div><h3>Know what is offered</h3><p>We explain discounts, rewards, and sweepstakes in plain English—because they are not the same thing.</p></div></div>
      <div class="principle-item"><span class="principle-number">02</span><div><h3>Read beyond the headline</h3><p>Learn where to find sponsor details, eligibility rules, deadlines, and redemption conditions.</p></div></div>
      <div class="principle-item"><span class="principle-number">03</span><div><h3>Protect your details</h3><p>Spot suspicious claims and understand what information a promotion may request or share.</p></div></div>
    </div>
  </section>

  <section class="featured-section section-space">
    <div class="container">
      <div class="section-heading"><div><span class="section-kicker">THE READING ROOM</span><h2>Guides worth <em>knowing.</em></h2></div><a class="text-link" href={`${base}guides/`}>View all guides <span>→</span></a></div>
      <div class="guide-grid">{featured.map((guide) => <GuideCard guide={guide} base={base} />)}</div>
    </div>
  </section>

  <section class="safety-banner-section">
    <div class="container safety-banner"><div class="safety-icon">✳</div><div><span class="section-kicker">A QUICK REMINDER</span><h2>A prize should never cost you<br /><em>your peace of mind.</em></h2><p>Be cautious of guaranteed-win messages, unexpected fees, and requests for passwords or one-time codes.</p></div><a class="button button-light" href={`${base}guides/spot-fake-gift-card-giveaways/`}>Read safety guide <span>↗</span></a></div>
  </section>

  <section class="newsletter-note section-space"><div class="container newsletter-inner"><div><span class="section-kicker">OUR EDITORIAL PROMISE</span><h2>Useful information.<br /><em>No hype required.</em></h2></div><p>RewardPath Guide is an independent educational resource. We do not issue gift cards, select sweepstakes winners, or guarantee rewards. Always verify a promotion with its named sponsor and official rules.</p></div></section>
</SiteLayout>
